# The existing brief analyser and evidence analyser use Groq.
GROQ_API_KEY=

# Search can be changed without changing application code: exa, fake, or groq-browser.
SEARCH_PROVIDER=exa
EXA_API_KEY=
SEARCH_MAX_RESULTS=25
SEARCH_TIMEOUT_MS=15000

# Server-only PostgreSQL connection. Netlify Database injects this in hosted runtimes.
NETLIFY_DB_URL=
CONTACT_HASH_PEPPER=

# Uploaded brief bytes use the local protected folder outside Netlify and Netlify Blobs when deployed.
# Set BRIEF_FILE_STORAGE=netlify-blobs explicitly in hosted environments. Netlify runtime context is also detected.
BRIEF_FILE_STORAGE=
NETLIFY_BLOBS_REGION=

# Shared pilot access gate. Keep local until the AUTH-004 deployment checks pass.
AUTH_SECRET=
# Temporary one-time setup token for /bootstrap. Remove it after the first credential is created.
AUTH_BOOTSTRAP_SECRET=
APP_ORIGIN=http://127.0.0.1:3000
APP_ACCESS_MODE=local

# Disposable PostgreSQL database used only by authentication integration tests.
AUTH_INTEGRATION_DATABASE_URL=
